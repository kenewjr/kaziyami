{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AniyomiRepositoryIndex",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "pkg", "apk", "lang", "code", "version", "nsfw", "sources"],
    "properties": {
      "name": {
        "type": "string"
      },
      "pkg": {
        "type": "string",
        "pattern": "^eu\\.kanade\\.tachiyomi\\.animeextension\\.[a-z]{2}\\.[a-z0-9]+$"
      },
      "apk": {
        "type": "string"
      },
      "lang": {
        "type": "string",
        "minLength": 2
      },
      "code": {
        "type": "integer",
        "minimum": 1
      },
      "version": {
        "type": "string"
      },
      "nsfw": {
        "type": "integer",
        "enum": [0, 1]
      },
      "hasReadme": {
        "type": "integer"
      },
      "hasChangelog": {
        "type": "integer"
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["name", "lang", "id", "baseUrl"],
          "properties": {
            "name": {
              "type": "string"
            },
            "lang": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "baseUrl": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
